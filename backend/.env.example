# Ambiente local (SQLite) — em produção na AWS, trocar por credenciais do RDS PostgreSQL
NODE_ENV=development
PORT=4000
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=7d

# Domínio(s) do frontend autorizados a chamar a API (separados por vírgula).
# Sem essa variável, o CORS fica aberto — ok para desenvolvimento local, não para produção.
# CORS_ORIGIN=http://localhost:5173

# Em produção (AWS RDS):
# DB_DIALECT=postgres
# DB_HOST=ifconnect.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=ifconnect
# DB_USER=postgres
# DB_PASSWORD=xxxxxxxx

# Armazenamento de imagens (produção — AWS S3)
# AWS_REGION=us-east-1
# S3_BUCKET=ifconnect-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
