# Ambiente local (SQLite) — em produção na AWS, trocar por credenciais do RDS PostgreSQL
NODE_ENV=development
PORT=4000
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=7d

# Domínio(s) do frontend autorizados a chamar a API (separados por vírgula).
# Sem essa variável, o CORS fica aberto — ok para desenvolvimento local, não para produção.
# CORS_ORIGIN=http://localhost:5173

# Assistente de IA (Opção A). O sistema funciona normalmente sem chave: cai no modo "busca".
AGENTE_IA_ENABLED=true
AGENTE_IA_PROVIDER=groq
AGENTE_IA_API_KEY=
AGENTE_IA_MODEL=llama-3.3-70b-versatile
AGENTE_IA_TIMEOUT_MS=8000
# requisições por minuto por IP
AGENTE_IA_RATE_LIMIT=10
# RAG (desligado = comportamento atual)
AGENTE_RAG_ENABLED=false
AGENTE_RAG_EMBEDDING_PROVIDER=gemini
AGENTE_RAG_EMBEDDING_MODEL=gemini-embedding-001
AGENTE_RAG_EMBEDDING_DIM=768
AGENTE_RAG_EMBEDDING_API_KEY=
AGENTE_RAG_TOP_K=4
# AGENTE_RAG_MIN_SCORE= (definir após calibrar com o conjunto de avaliação)

# Em produção (AWS RDS):
# DB_DIALECT=postgres
# DB_HOST=ifconnect.xxxxxxxx.us-east-1.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=ifconnect
# DB_USER=postgres
# DB_PASSWORD=xxxxxxxx

# Armazenamento de imagens (produção — AWS S3)
# AWS_REGION=us-east-1
# S3_BUCKET=ifconnect-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
